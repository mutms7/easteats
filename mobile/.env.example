# These values are public and embedded into the application. Never add a secret key.
EXPO_PUBLIC_API_ORIGIN=https://easteats.vercel.app
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Enable only after the Apple provider is configured and tested in Supabase.
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
# Existing MapTiler public key. Reuse the service, with a mobile-compatible key restriction.
EXPO_PUBLIC_MAPTILER_KEY=
# Set after linking this directory to an Expo account via eas init.
EAS_PROJECT_ID=
EAS_OWNER=
